  LineAttackNormal: "\u6765\u305F\u6765\u305F\uFF01 \u5927\u4E08\u592B\u3001\u3044\u3064\u3082\u306E\u624B\u53E3\u3060\u3088\uFF01"
  LineParry: "\u30BF\u30A4\u30DF\u30F3\u30B0\u5408\u308F\u305B\u3066\u2026\u2026\u3044\u3063\u3051\u30FC\uFF01"
  LineWin: "\u3084\u3063\u305F\u30FC\uFF01 \u3055\u3059\u304C\u3060\u306D\uFF01"
  LineWinNarrow: "\u3042\u3076\u306A\u30FC\u2026\u2026\uFF01 \u30AE\u30EA\u30AE\u30EA\u30BB\u30FC\u30D5\u3060\u3088\u301C"
  LineLose: "\u3046\u3045\u2026\u2026\u5B88\u308A\u304D\u308C\u306A\u304B\u3063\u305F\u2026\u2026\u3054\u3081\u3093"
  LineGameOver: "\u3054\u3081\u3093\u2026\u2026\u529B\u306B\u306A\u308C\u306A\u304B\u3063\u305F\u3088\u2026\u2026"
  LineClear: "1\u5E74\u9593\u304A\u3064\u304B\u308C\u3055\u307E\uFF01 \u307B\u3093\u3068\u306B\u7ACB\u6D3E\u3060\u3063\u305F\u3088\uFF01"
