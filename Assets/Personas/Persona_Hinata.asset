  AnimationFrames: []
  LineNormal: "\u4ECA\u65E5\u3082\u5E73\u548C\u3060\u306D\uFF01 \u4ECA\u306E\u3046\u3061\u306B\u5099\u3048\u3061\u3083\u304A\uFF01"
  LineNoDefense: "\u307E\u3060\u5BFE\u7B56\u30BC\u30ED\u3060\u3088\uFF01\uFF1F \u4F55\u304B\u3072\u3068\u3064\u5165\u308C\u3088\u3001\u306D\uFF1F"
  LineLowBudget: "\u304A\u8CA1\u5E03\u30D4\u30F3\u30C1\u2026\u2026\uFF01 \u3053\u3053\u306F\u6211\u6162\u306E\u3057\u3069\u3053\u308D\u3060\u306D"
  LineLowTrust: "\u307F\u3093\u306A\u306E\u4FE1\u983C\u3001\u4E0B\u304C\u3063\u3061\u3083\u3063\u3066\u308B\u2026\u2026\u96D1\u52D9\u3082\u3061\u3083\u3093\u3068\u3084\u308D\uFF01"
  LineHighStress: "\u307F\u3093\u306A\u75B2\u308C\u3066\u308B\u307F\u305F\u3044\u3002\u7DE0\u3081\u3064\u3051\u3059\u304E\u306F\u9006\u306B\u5371\u306A\u3044\u3088\uFF1F"
  LineEndgame: "\u5E74\u5EA6\u672B\u304C\u8FD1\u3044\u3088\uFF01 \u3053\u3053\u304C\u8E0F\u3093\u5F35\u308A\u3069\u3053\u308D\u3063\uFF01"
  LineGood: "\u3044\u3044\u611F\u3058\uFF01 \u3053\u306E\u8ABF\u5B50\u3067\u3044\u3053\u30FC\uFF01"
  LineAttackSevere: "\u3046\u308F\u3063\u3001\u3053\u308C\u30E4\u30D0\u3044\u3084\u3064\u2026\u2026\uFF01
    \u843D\u3061\u7740\u3044\u3066\u3001\u306D\uFF01"
  LineAttackNew: "\u898B\u305F\u3053\u3068\u306A\u3044\u624B\u53E3\u3060\u3088\uFF01
    \u614E\u91CD\u306B\u3044\u3053\uFF01"
  LineAttackNormal: "\u6765\u305F\u6765\u305F\uFF01 \u5927\u4E08\u592B\u3001\u3044\u3064\u3082\u306E\u624B\u53E3\u3060\u3088\uFF01"
  LineParry: "\u30BF\u30A4\u30DF\u30F3\u30B0\u5408\u308F\u305B\u3066\u2026\u2026\u3044\u3063\u3051\u30FC\uFF01"
  LineWin: "\u3084\u3063\u305F\u30FC\uFF01 \u3055\u3059\u304C\u3060\u306D\uFF01"
  LineWinNarrow: "\u3042\u3076\u306A\u30FC\u2026\u2026\uFF01 \u30AE\u30EA\u30AE\u30EA\u30BB\u30FC\u30D5\u3060\u3088\u301C"
  LineLose: "\u3046\u3045\u2026\u2026\u5B88\u308A\u304D\u308C\u306A\u304B\u3063\u305F\u2026\u2026\u3054\u3081\u3093"
  LineGameOver: "\u3054\u3081\u3093\u2026\u2026\u529B\u306B\u306A\u308C\u306A\u304B\u3063\u305F\u3088\u2026\u2026"
  LineClear: "1\u5E74\u9593\u304A\u3064\u304B\u308C\u3055\u307E\uFF01 \u307B\u3093\u3068\u306B\u7ACB\u6D3E\u3060\u3063\u305F\u3088\uFF01"
